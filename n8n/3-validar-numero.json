      "position": [80, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst data = items.map((item) => item.json);\n\nreturn [\n  {\n    json: {\n      success: true,\n      data,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Montar resposta",
      "id": "code-build-response",
      "position": [320, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "name": "Responder",
      "id": "respond-webhook",
